<Project Sdk="Microsoft.NET.Sdk">
  <!-- 판 시뮬레이션 실행기. 게임 Core와 Assets/Scripts/Simulation을 그대로 컴파일한다(Unity 없이). 설명: Docs/Simulation/README.md -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>BlackHole.Simulation.Tool</AssemblyName>
    <RootNamespace>BlackHole.Simulation.Tool</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 판을 수천 번 돌리므로 Debug로 실행해도 최적화한다. -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
    <Compile Include="../../Assets/Scripts/Simulation/**/*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>
</Project>
